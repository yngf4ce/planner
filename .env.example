# Перечень переменных окружения LockedLife.
# ЗДЕСЬ НЕТ НАСТОЯЩИХ ЗНАЧЕНИЙ — и не должно быть.
# Настоящие значения вводятся только в:
#   Supabase → Project Settings → Edge Functions → Secrets
#   GitHub → репозиторий → Settings → Secrets and variables → Actions
# Никогда не отправляйте эти значения в чат и не коммитьте файл .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # токен бота от @BotFather
TELEGRAM_WEBHOOK_SECRET=       # случайная строка; Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token
ALLOWED_TELEGRAM_IDS=          # ваш Telegram ID (несколько — через запятую)
ALLOWED_ORIGINS=               # откуда разрешены запросы: https://yngf4ce.github.io

# --- Supabase ---
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY внутри Edge Functions доступны автоматически.
# Сервисный ключ НИКОГДА не попадает в index.html.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Распознавание речи и ИИ ---
GROQ_API_KEY=                  # console.groq.com → API Keys
GEMINI_API_KEY=                # aistudio.google.com → Get API key (если выберем Gemini)

# --- Для автоматического деплоя через GitHub Actions (позже) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
